{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "eSim-Cloud Simulation Pipeline – system health and SLO visibility (Task 4)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "title": "Job Throughput",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(esim_simulation_jobs_started_total[5m])",
          "legendFormat": "Started / sec"
        },
        {
          "expr": "rate(esim_simulation_jobs_succeeded_total[5m])",
          "legendFormat": "Succeeded / sec"
        },
        {
          "expr": "rate(esim_simulation_jobs_failed_total[5m])",
          "legendFormat": "Failed / sec"
        },
        {
          "expr": "rate(esim_simulation_jobs_timeout_total[5m])",
          "legendFormat": "Timeout / sec"
        }
      ],
      "title": "Job Rate (5m window)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "targets": [
        {
          "expr": "rate(esim_simulation_jobs_failed_total[5m]) / (rate(esim_simulation_jobs_started_total[5m]) + 1e-9)",
          "legendFormat": "Failure Rate"
        }
      ],
      "title": "Failure Rate",
      "type": "gauge"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "expr": "esim_simulation_active_jobs{status='QUEUED'}", "legendFormat": "QUEUED" },
        { "expr": "esim_simulation_active_jobs{status='RUNNING'}", "legendFormat": "RUNNING" },
        { "expr": "esim_simulation_active_jobs{status='DISPATCHING'}", "legendFormat": "DISPATCHING" }
      ],
      "title": "Active Jobs by State",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(esim_simulation_queue_wait_seconds_bucket[5m]))",
          "legendFormat": "p50 Queue Wait"
        },
        {
          "expr": "histogram_quantile(0.95, rate(esim_simulation_queue_wait_seconds_bucket[5m]))",
          "legendFormat": "p95 Queue Wait"
        },
        {
          "expr": "histogram_quantile(0.99, rate(esim_simulation_queue_wait_seconds_bucket[5m]))",
          "legendFormat": "p99 Queue Wait"
        }
      ],
      "title": "Queue Wait Time (p50/p95/p99)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(esim_simulation_execution_seconds_bucket[5m]))",
          "legendFormat": "p50 Execution"
        },
        {
          "expr": "histogram_quantile(0.95, rate(esim_simulation_execution_seconds_bucket[5m]))",
          "legendFormat": "p95 Execution"
        },
        {
          "expr": "histogram_quantile(0.99, rate(esim_simulation_execution_seconds_bucket[5m]))",
          "legendFormat": "p99 Execution"
        }
      ],
      "title": "Execution Time (p50/p95/p99)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "tags": ["esim-cloud", "simulation", "slo"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "eSim-Cloud Simulation Pipeline",
  "uid": "esim-sim-pipeline-v1",
  "version": 1
}
